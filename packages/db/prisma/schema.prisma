// FitFusion AI — Prisma schema.
// Model names and key fields conform to CONTRACT.md (fixed integration surface).
// Allowed string values for "enum-like" fields (e.g. VerificationToken.type,
// DiaryEntry.source, Recipe.dietCategory) are enforced server-side via zod in
// apps/web (see CONTRACT.md); they are plain String columns here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  verificationTokens VerificationToken[]
  sessions           Session[]
  consents           Consent[]
  profile            Profile?
  subscription       Subscription?
  measurements       Measurement[]
  diaryEntries       DiaryEntry[]
  waterLogs          WaterLog[]
  mealPlans          MealPlan[]
  favoriteMeals      FavoriteMeal[]
  workoutPlans       WorkoutPlan[]
  workoutSessions    WorkoutSession[]
  personalRecords    PersonalRecord[]
  foodScans          FoodScan[]
  uploads            Upload[]
  coachConversations CoachConversation[]
  dataExports        DataExport[]
  recipes            Recipe[]
  menuCorrections    MenuCorrection[]
  submittedMenuItems MenuSubmission[] @relation("MenuSubmissionSubmitter")
  reviewedMenuItems  MenuSubmission[] @relation("MenuSubmissionReviewer")
  healthConnections  HealthConnection[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  // "email_verify" | "password_reset"
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id          String   @id @default(cuid())
  userId      String
  type        String
  granted     Boolean
  grantedAt   DateTime
  textVersion String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Profile / subscription
// ---------------------------------------------------------------------------

model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  displayName           String?
  dateOfBirth           DateTime?
  sex                   String?
  heightCm              Float?
  activityLevel         String?
  goal                  String?
  targetWeightKg        Float?
  fitnessExperience     String?
  workoutLocation       String?
  equipment             String[]  @default([])
  workoutDays           String[]  @default([])
  workoutMinutesPerDay  Int?
  dietPreference        String?   @default("flexible")
  allergies             String[]  @default([])
  intolerances          String[]  @default([])
  halalOnly             Boolean   @default(false)
  preferredCuisines     String[]  @default([])
  dislikedIngredients   String[]  @default([])
  mealsPerDay           Int?      @default(3)
  budgetTier            String?
  maxCookMinutes        Int?
  healthLimitations     String?
  exerciseRestrictions  String?
  eatingDisorderRisk    Boolean   @default(false)
  isPregnant            Boolean   @default(false)
  isBreastfeeding       Boolean   @default(false)
  onboardingCompletedAt DateTime?
  // V18 location & localization
  country               String    @default("PK")
  cityRegion            String?
  // 'en' | 'ur' | 'roman-ur'
  language              String    @default("en")
  // 'metric' | 'imperial'
  unitSystem            String    @default("metric")
  ramadanMode           Boolean   @default(false)
  // V20 Feature 5: active intermittent-fast record (JSON), cross-device sync.
  fastingSession        Json?
  // V20 Feature 1: optional user-set daily calorie target override (kcal),
  // e.g. from the adaptive-TDEE dashboard card. NULL = computed target.
  calorieTargetOverrideKcal Int?
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  planId                   String    @default("free")
  status                   String    @default("active")
  billingPeriod            String?
  provider                 String?
  providerRef              String?
  currentPeriodEnd         DateTime?
  // Stripe test-mode/live identifiers. Paid access is granted ONLY by the
  // signature-verified Stripe webhook — never by a frontend claim.
  stripeCustomerId         String?
  stripeSubscriptionId     String?   @unique
  // When the subscription first entered past_due (arrears clock start for the
  // finite grace window PAST_DUE_GRACE_DAYS). NULL = not in arrears.
  pastDueSince             DateTime?
  // The most recent Stripe Checkout Session started by POST
  // /api/billing/checkout for this user (test mode ids are synthetic).
  // Used to resolve retried / double-POST checkout requests to the SAME
  // session instead of silently creating a second one (duplicate-
  // subscription guard). NULL once the webhook binds a subscription
  // (or the session expires / completes).
  stripeCheckoutSessionId  String?
  stripeCheckoutSessionUrl String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotency log for the Stripe webhook. Each Stripe event id is processed
// at most once: the row is claimed (created with processedAt = null) before
// handling, and marked processed afterwards. Duplicate, delayed, or
// out-of-order deliveries are safely skipped.
model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Nutrition: measurements, foods, diary, water
// ---------------------------------------------------------------------------

model Measurement {
  id         String   @id @default(cuid())
  userId     String
  // "weight" | "height" | "waist" | "bmi" | "steps" ("steps" = daily step
  // counts imported from a connected health provider, unit "steps")
  type       String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  note       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Food {
  id            String    @id @default(cuid())
  name          String    @unique
  brand         String?
  servingSize   Float
  servingUnit   String
  // V21.2: canonical grams per serving. NULL until seeded/backfilled.
  // Fixes per-100-g math for count servings (chapati servingSize: 1) and
  // volume servings (milk servingSize: 250 ml) — `100 / servingSize` was
  // only valid when servingSize was grams. Diary serving semantics are
  // unchanged (diary scales per-serving nutrients, never this column).
  servingWeightG Float?
  kcal          Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float
  // "seeded" | "user" | "ai_estimate" | "openfoodfacts" | "restaurant"
  source        String
  verified      Boolean   @default(false)
  // V18: richer verification — "estimate" (default) | "verified"
  verification  String    @default("estimate")
  // Basis of an estimate, e.g. "USDA FoodData Central generic equivalent"
  basis         String?
  categoryId    String?
  // ISO country codes where this food is available
  countryCodes  String[]  @default([])
  barcode       String?   @unique
  sourceRef     String?
  lastCheckedAt DateTime?
  // V20: micronutrient snapshot, typed JSON (closed MicroKey shape — see
  // packages/core/src/micronutrients.ts; absent key = "not tracked",
  // never 0). Null for foods with no micro data (all seeded foods).
  micros        Json?
  createdAt     DateTime  @default(now())

  diaryEntries DiaryEntry[]
  category     FoodCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases      FoodAlias[]
  portions     HouseholdPortion[]
}

model DiaryEntry {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  mealType       String
  foodId         String?
  customName     String?
  servings       Float    @default(1)
  kcal           Float
  proteinG       Float
  carbsG         Float
  fatG           Float
  fiberG         Float
  // "manual" | "scan" | "recipe" | "plan"
  source         String
  scanId         String?
  recipeId       String?
  idempotencyKey String?
  // V21.4: durable indicator that this entry was logged with explicitly
  // acknowledged incomplete (partial) recipe nutrition. NULL/false =
  // complete values. Set server-side at log time only.
  nutritionPartial Boolean?
  // V20: micro snapshot at log time (closed MicroKey shape, standard
  // units; absent key = "not tracked"). Entries logged from USDA web
  // results carry their micros; everything else is null.
  micros         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  food   Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)
  scan   FoodScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  recipe Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  ml        Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MealPlan {
  id            String   @id @default(cuid())
  userId        String
  weekStart     DateTime @db.Date
  days          Json
  calorieTarget Int
  // "template" | "ai"
  generatedBy   String
  status        String   @default("active")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model FavoriteMeal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  items     Json
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  fiberG    Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Recipes
// ---------------------------------------------------------------------------

model Cuisine {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?
  createdAt DateTime @default(now())

  recipes Recipe[]
}

model Recipe {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  cuisineId         String?
  // "vegetarian" | "non_vegetarian"
  dietCategory      String
  tags              String[] @default([])
  servings          Int
  prepMin           Int
  cookMin           Int
  difficulty        String
  ingredients       Json
  instructions      Json
  kcalPerServing    Float
  proteinPerServing Float
  carbsPerServing   Float
  fatPerServing     Float
  fiberPerServing   Float
  imageUrl          String?
  videoUrl          String?
  // "curated" | "ai" | "user"
  source            String
  verified          Boolean  @default(false)
  // V21.3: JSON evidence for the verified/reviewed data-quality tiers
  // (canonical shapes documented in the migration file and in
  // packages/core/src/recipe-claims.ts). NULL = no evidence recorded.
  verificationEvidence Json?
  reviewEvidence        Json?
  allergens         String[] @default([])
  // V21.4: true when the `allergens` list was produced by ingredient-name
  // screening (custom-recipe creation endpoint, v21.4+). False = screening
  // was never recorded (all pre-v21.4 rows, incl. all 270 seed recipes) —
  // an empty list on an unscreened recipe must NOT render as "no allergens".
  // Screening is still name-derived only: never a certified allergen
  // analysis (ALLERGEN_CAVEAT still required wherever the list appears).
  allergenScreened  Boolean  @default(false)
  // V18: user-created private home recipes
  userId            String?
  isPrivate         Boolean  @default(false)
  yieldGrams        Float?
  // V21: recipe library expansion
  mealType          String?
  needsReview       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // V21.5: content revision hash for optimistic concurrency (PATCH and the
  // admin review route detect mid-write conflicts with 409 `stale_recipe`).
  // Nullable: rows written before v21.5 carry no hash (no backfill); call
  // sites treat NULL as "no revision known" and fall back to the
  // pre-v21.5 write path.
  contentHash       String?
  // V21.7: mutation counter for optimistic concurrency. contentHash is
  // content IDENTITY (changes only on a material content change); revision
  // increments on EVERY recipe or review-state mutation — material PATCH,
  // metadata-only PATCH, admin review, admin verify, admin clear — in the
  // SAME atomic conditional updateMany as the mutation itself. Clients
  // send the revision they read as `expectedRevision`; a write whose
  // stored revision no longer matches is rejected with 409 `stale_recipe`.
  // Existing rows default to 0 (forward-only additive migration; never
  // reset by the backfill script or any other write path).
  revision          Int      @default(0)

  cuisine      Cuisine?     @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  diaryEntries DiaryEntry[]
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases      RecipeAlias[]

  @@index([cuisineId])
  @@index([dietCategory])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// V21.2: persisted recipe alias names (English, Urdu script, Roman Urdu)
// ---------------------------------------------------------------------------
// Seed aliases were previously carried on the seed objects but never
// persisted; this table stores them so `GET /api/recipes?q=` can match
// titles AND aliases. One row per (recipe, normalized alias string);
// language is a hint only ('en' | 'ur' | 'roman-ur'), never authoritative.

model RecipeAlias {
  id              String   @id @default(cuid())
  recipeId        String
  alias           String
  normalizedAlias String
  language        String?
  createdAt       DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, normalizedAlias])
  @@index([normalizedAlias])
}

// ---------------------------------------------------------------------------
// Exercises & workouts
// ---------------------------------------------------------------------------

model Exercise {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  muscleGroups    String[]
  equipment       String[]
  difficulty      String
  exerciseType    String
  trainingStyles  String[]
  homeSuitable    Boolean
  gymSuitable     Boolean
  steps           Json
  breathing       String?
  commonMistakes  Json
  easierVariation String?
  harderVariation String?
  safetyNotes     String?
  mediaType       String   @default("none")
  mediaUrl        String?
  createdAt       DateTime @default(now())

  workoutLogs     WorkoutLog[]
  personalRecords PersonalRecord[]
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime @db.Date
  days        Json
  // "template" | "ai"
  generatedBy String
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]

  @@index([userId, weekStart])
}

model WorkoutSession {
  id            String    @id @default(cuid())
  userId        String
  workoutPlanId String?
  name          String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  status        String    @default("in_progress")
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  logs        WorkoutLog[]

  @@index([userId, startedAt])
}

model WorkoutLog {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  sets       Json
  notes      String?
  createdAt  DateTime @default(now())

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([exerciseId])
}

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  metric     String
  value      Float
  unit       String
  achievedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, metric])
}

// ---------------------------------------------------------------------------
// Food scans, coach, data export
// ---------------------------------------------------------------------------

model FoodScan {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String?
  items     Json
  // "pending" | "review" | "confirmed" | "failed" | "not_configured"
  status    String
  provider  String?
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaryEntries DiaryEntry[]

  @@index([userId])
}

model CoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId])
}

model CoachMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant" | "system"
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model DataExport {
  id          String    @id @default(cuid())
  userId      String
  // "pending" | "ready" | "failed"
  status      String
  fileUrl     String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// V21.8 — Upload ownership registry: every file written through
// lib/storage is recorded here with its uploader + intended purpose at
// upload time, so GET /api/uploads/[key] can authorize by ownership
// instead of mere authentication. `expiresAt` implements the retention
// policy: transient uploads (menu extraction, failed/not-configured
// analysis) expire after UPLOAD_TEMP_RETENTION_HOURS (default 24h) and
// are purged by the admin-gated POST /api/uploads/purge; uploads tied to
// a user record (scan, data_export) have no expiry and live until the
// record / account is deleted.
// ---------------------------------------------------------------------------

model Upload {
  id        String    @id @default(cuid())
  key       String    @unique
  userId    String
  // "scan" | "menu_extract" | "data_export"
  purpose   String
  mime      String
  byteSize  Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// V18 — Location-aware food database: taxonomy, aliases, portions
// ---------------------------------------------------------------------------

model FoodCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  nameUrdu  String?
  sortOrder Int     @default(0)

  foods Food[]
}

model FoodAlias {
  id       String @id @default(cuid())
  foodId   String
  alias    String
  // 'en' | 'ur' | 'roman-ur'
  language String @default("en")

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@index([foodId])
}

model HouseholdPortion {
  id        String  @id @default(cuid())
  foodId    String
  label     String // e.g. "1 roti", "1 katori daal"
  labelUrdu String?
  grams     Float? // gram equivalent of the household measure
  ml        Float? // ml equivalent (for drinks)
  sortOrder Int     @default(0)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

// ---------------------------------------------------------------------------
// V18 — Packaged products (Open Food Facts cache)
// ---------------------------------------------------------------------------

model CachedProduct {
  // barcode is the id
  id        String   @id
  provider  String   @default("openfoodfacts")
  payload   Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

// ---------------------------------------------------------------------------
// V18 — Restaurants & menus
// ---------------------------------------------------------------------------

model Restaurant {
  id              String    @id @default(cuid())
  // 'google_places' | 'manual'
  provider        String
  providerPlaceId String?   @unique
  name            String
  address         String?
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  rating          Float?
  priceLevel      Int?
  website         String?
  menuUrl         String?
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())

  menuItems RestaurantMenuItem[]
  menuSubmissions MenuSubmission[]

  @@index([city])
}

model RestaurantMenuItem {
  id              String    @id @default(cuid())
  restaurantId    String
  name            String
  description     String?
  portion         String?
  kcal            Float?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  fiberG          Float?
  // "restaurant_published" | "calculated_estimate" | "menu_photo_estimate"
  //   | "user_submitted" | "unavailable"
  nutritionStatus String    @default("unavailable")
  assumptions     Json?
  source          String?
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  corrections MenuCorrection[]

  @@index([restaurantId])
}

model MenuCorrection {
  id         String   @id @default(cuid())
  menuItemId String
  userId     String
  note       String
  // "open" | "accepted" | "rejected"
  status     String   @default("open")
  createdAt  DateTime @default(now())

  menuItem RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// V21.8 — Menu submissions (P2): customer menu-photo submissions stay
// PRIVATE until an admin reviews and approves them. Approving publishes a
// RestaurantMenuItem copy; pending/rejected submissions never appear in the
// public GET /api/restaurants/[id]/menu response.
// ---------------------------------------------------------------------------

model MenuSubmission {
  id              String    @id @default(cuid())
  restaurantId    String
  name            String
  description     String?
  portion         String?
  kcal            Float?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  fiberG          Float?
  // same value set as RestaurantMenuItem.nutritionStatus
  nutritionStatus String    @default("unavailable")
  assumptions     Json?
  source          String?
  matchedFoodId   String?
  // "pending" | "approved" | "rejected"
  status          String    @default("pending")
  submittedBy     String
  submittedAt     DateTime  @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  // RestaurantMenuItem id created when this submission was approved
  publishedItemId String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  submitter  User       @relation("MenuSubmissionSubmitter", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("MenuSubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([status])
  @@index([submittedBy])
}

// ---------------------------------------------------------------------------
// Health sync (V20 Feature 6) — Google Fit OAuth connection
// ---------------------------------------------------------------------------

model HealthConnection {
  id                  String    @id @default(cuid())
  userId              String    @unique
  // "google" (Apple HealthKit is not reachable from a web PWA — see docs/health-sync.md)
  provider            String    @default("google")
  // AES-256-GCM encrypted OAuth tokens (see apps/web/lib/health-crypto.ts).
  // Never plaintext, never returned by any API.
  accessTokenEnc      String
  refreshTokenEnc     String?
  accessTokenExpiresAt DateTime
  lastSyncAt          DateTime?
  lastSyncError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
