# ---- FitFusion AI — environment configuration ----
# SINGLE SOURCE OF TRUTH: the repo-root `.env` (next to package.json) is the
# ONE AND ONLY env file. `cp .env.example .env`, then edit `.env`.
#   - `apps/web/next.config.js` explicitly loads the repo-root `.env` via
#     `dotenv` at startup, so every server variable is available from the
#     very first request (Next.js 14 has no envDir option — without this it
#     would only look inside `apps/web/`).
#   - NEVER create `apps/web/.env` (or `.env.local` next to it) — it would
#     silently compete with the root file. `node scripts/check-env.mjs`
#     errors out if such a file exists.
#   - Real shell/CI environment variables always WIN over the file (dotenv
#     only fills variables that are not already set).
#   - `APP_URL` is the public base URL: used for Stripe success/cancel
#     redirect URLs and as the base of the Stripe webhook URL
#     (`{APP_URL}/api/billing/webhook`).

# ---- Database ----
DATABASE_URL="postgresql://fitfusion:fitfusion_dev_pw@localhost:5432/fitfusion"

# ---- App ----
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Session lifetime in days
SESSION_TTL_DAYS="30"

# ---- Branding overrides (optional; defaults live in config/branding.ts) ----
# NEXT_PUBLIC_APP_NAME="FitFusion AI"

# ---- AI provider (OpenAI-compatible chat + vision). Leave unset for graceful "not configured" state. ----
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"
# AI_VISION_MODEL="gpt-4o-mini"

# ---- OAuth (optional; when unset, buttons are hidden and API returns not_configured) ----
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""

# ---- Billing provider (optional). BILLING_PROVIDER=none|sandbox|stripe ----
# Safety rule (enforced in apps/web/lib/billing.ts): a paid plan NEVER becomes
# active locally without a provider confirmation. In `none` and `stripe` mode,
# requesting a paid plan is REJECTED with HTTP 402 (code `payment_required`);
# activation happens only via the webhook after Stripe confirms payment.
#   - `none`     (default, safe): no billing at all. Paid selections 402.
#   - `sandbox`  (test-only simulation): simulated upgrades are allowed but
#                are always labeled test-only and never imply a charge.
#   - `stripe`   requires ALL FOUR vars below. An API key ALONE is not
#                enough: without STRIPE_WEBHOOK_SECRET the webhook cannot be
#                verified (checkouts refuse with 503), and without the price
#                IDs a checkout session cannot be built. See README "Billing".
BILLING_PROVIDER="none"
# Stripe secret key — test keys ONLY until you are ready for real money.
# (sk_test_... for testing, sk_live_... for production.)
# STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_...) from the Stripe dashboard for the
# endpoint {APP_URL}/api/billing/webhook. Required to verify HMAC signatures.
# STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs (test mode: price_... from the dashboard's Products page,
# one price per plan, recurring subscription). Resolved SERVER-SIDE via
# config/plans.ts STRIPE_PRICE_ENV — never send Price IDs from the client.
# STRIPE_PRICE_DIET="price_..."
# STRIPE_PRICE_DIET_EXERCISE="price_..."

# ---- Object storage for food-scan uploads ----
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER="local"
# Local driver: directory (relative to apps/web) served from /uploads
STORAGE_LOCAL_DIR="./uploads"
# S3-compatible driver:
# STORAGE_ENDPOINT="https://s3.amazonaws.com"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="fitfusion-uploads"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Max upload size in MB for food photos
UPLOAD_MAX_MB="8"

# ---- Web food search (V19): USDA FoodData Central ----
# Optional. Free key: sign up at https://api.nal.usda.gov and paste it here.
# Powers the "Search the web" results in the Nutrition add-food modal
# (authoritative reference values). Without it, web search still works via
# Open Food Facts (no key needed) — only the USDA source is skipped.
# Server-side only; never exposed to the browser.
# USDA_API_KEY=<your-free-key-from-api.nal.usda.gov>

# ---- Restaurant discovery (Phase C): Google Places API (New) ----
# Server-side only. Without it, /log/restaurants shows a setup screen +
# manual city entry (no fake results). See docs/google-places-setup.md for
# API enablement, billing, key restrictions and Render steps.
# GOOGLE_PLACES_API_KEY=""

# ---- Restaurant menu administration (Phase D) ----
# Comma-separated email allowlist for the admin menu endpoints and the
# /admin/menus page (menu item create/edit/verify, correction queue).
# Empty or missing => NO ONE is an admin (fail closed).
# ADMIN_EMAILS="owner@example.com,editor@example.com"

# ---- Email (verification + password reset). Development default logs to console. ----
# EMAIL_DRIVER=console | smtp
EMAIL_DRIVER="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="FitFusion AI <no-reply@example.com>"

# ---- Hosted deployments (optional) ----
# The repo-root .env is the documented LOCAL-DEV file, but it is NOT
# mandatory. When DATABASE_URL and SESSION_SECRET are provided as
# platform environment variables (Vercel / Render / Fly dashboard, CI
# secrets, systemd Environment=, Docker -e), `node scripts/check-env.mjs`
# and GET /api/health accept them and no physical .env file is required.
# (dotenv only fills variables that are not already set, so the platform
# always wins over the file when both exist.)
#
# Set NODE_ENV=production on every hosted/production deployment. With
# NODE_ENV=production, obvious placeholder secrets (the SESSION_SECRET
# example value above, "changeme", etc.) are REJECTED at startup — the app
# refuses to run with them. In development they only produce a warning.
# NODE_ENV="production"
